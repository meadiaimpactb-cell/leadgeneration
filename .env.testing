# Testing environment.
#
# This file exists because its absence destroyed the development database once.
#
# `--env=testing` loads THIS file. Without it Laravel silently falls back to
# `.env`, so `php artisan migrate:fresh --env=testing --force` ran against
# amadcraft_b2b — the live development data — and wiped every table. The
# settings in phpunit.xml did not save it: those apply only when phpunit runs,
# never to an artisan command.
#
# Keep DB_DATABASE ending in `_test`. `AppServiceProvider` refuses destructive
# commands on any connection whose database name does not.

APP_NAME="Amad Craft"
APP_ENV=testing
APP_KEY=base64:LDx8mhODjSW51ZuzIUuJEiSAN0xZG+rLrvMEuoEKNls=
APP_URL=http://leadgeneration.test
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amadcraft_b2b_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# The SSR server is shared with the dev site; tests render through it.
BCRYPT_ROUNDS=4

# The eleven pages the landing-page decision retired stay ON in the suite,
# so their controllers and tests keep their coverage while they exist.
SITE_LEGACY_PAGES=true
