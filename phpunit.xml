<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run on MySQL, not SQLite. The schema leans on ENUM columns
            and JSON casts whose behaviour differs between the two, and the
            lead table is the one thing that must not surprise us in
            production (§8.3).
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="amadcraft_b2b_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            Image conversions are discarded here, and only here. The suite
            needs QUEUE_CONNECTION=sync so the queued CRM push runs inside the
            request; media-library used to inherit that connection, so every
            seeded image ran five GD resizes inline — 29s of DemoContentSeeder's
            34s, repaid on each test that seeds it.

            `thumb` is registered nonQueued and still runs, so the panel tiles
            a test looks at are real. Nothing asserts a derived file exists:
            MediaResource, HasAttachedMedia, Section and Media all guard with
            hasGeneratedConversion() and fall back to the original. A test that
            needs the real pipeline sets the connection back with config().
        -->
        <env name="MEDIA_QUEUE_CONNECTION" value="discard"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="APP_LOCALE" value="ar"/>
        <env name="APP_FALLBACK_LOCALE" value="ar"/>
        <env name="CRM_DRIVER" value="null"/>
        <env name="LEADS_NOTIFY_TO" value="leads@example.test"/>
        <env name="IP_HASH_SALT" value="testing-salt"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
