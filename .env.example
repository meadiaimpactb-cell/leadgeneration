###############################################################################
# Amad Craft — B2B Corporate Site
# Copy to .env and fill in. NEVER commit .env.
###############################################################################

APP_NAME="Amad Craft"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://leadgeneration.test

# ---- Localisation ----------------------------------------------------------
# The site is Arabic-first. English is a first-class version, gated by the
# `site.english_enabled` setting row (see §12 of PROJECT_BRIEF.md).
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL 8, managed via phpMyAdmin) ----------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amadcraft_b2b
DB_USERNAME=root
DB_PASSWORD=

# ---- Session / cache / queue ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail ------------------------------------------------------------------
# Local dev uses Laragon's Mailpit on :1025 — nothing leaves the machine.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@amadcraft.sa"
MAIL_FROM_NAME="${APP_NAME}"

# Where new-lead notifications land (comma-separated).
LEADS_NOTIFY_TO=

# ---- Inertia SSR -----------------------------------------------------------
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# ---- CRM (§6.3 — abstraction layer, never couple to one provider) ----------
# Drivers: null | webhook | odoo | zid
CRM_DRIVER=null
CRM_RETRY_ATTEMPTS=5

# Generic webhook fallback driver
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Odoo (must be integration-ready at launch)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# Zid
ZID_API_BASE=https://api.zid.sa
ZID_ACCESS_TOKEN=
ZID_STORE_ID=

# ---- Anti-spam (§6.1) ------------------------------------------------------
# Cloudflare Turnstile. Leave blank to disable in local dev.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Privacy ---------------------------------------------------------------
# Salt used to hash visitor IPs. Raw IPs are never stored. Rotate with care:
# rotating invalidates dedup matching against historic leads.
IP_HASH_SALT=

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# NOTE: tracking IDs (GA4, GTM, Meta Pixel, Clarity …) are deliberately NOT
# here. Per §14.1 they are managed from `settings` in the admin panel so the
# client can change them without a deploy.
###############################################################################
