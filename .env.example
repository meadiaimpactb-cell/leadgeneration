###############################################################################
# Amad Craft — B2B Corporate Site
# Copy to .env and fill in. NEVER commit .env.
###############################################################################

APP_NAME="Amad Craft"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://leadgeneration.test

# ---- Localisation ----------------------------------------------------------
# The site is Arabic-first. English is a first-class version, gated by the
# `site.english_enabled` setting row (see §12 of PROJECT_BRIEF.md).
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL 8, managed via phpMyAdmin) ----------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amadcraft_b2b
DB_USERNAME=root
DB_PASSWORD=

# ---- Session / cache / queue ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Where the `public` disk writes uploaded media. Leave empty everywhere the
# `public/storage` symlink can be created — the default is Laravel's own
# storage/app/public. Set it only on a host where symlink() is disabled, to
# the served directory itself, e.g.
#   MEDIA_DISK_ROOT=/home/USER/domains/example.com/public_html/b2b/public/storage
# Empty is treated as unset; see config/filesystems.php.
MEDIA_DISK_ROOT=
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail ------------------------------------------------------------------
# Local dev uses Laragon's Mailpit on :1025 — nothing leaves the machine.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@amadcraft.sa"
MAIL_FROM_NAME="${APP_NAME}"

# Where new-lead notifications land (comma-separated).
LEADS_NOTIFY_TO=

# ---- Inertia SSR -----------------------------------------------------------
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# ---- CRM (§6.3 — abstraction layer, never couple to one provider) ----------
# Drivers: null | webhook | odoo | zid
CRM_DRIVER=null
CRM_RETRY_ATTEMPTS=5

# Generic webhook fallback driver
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Odoo (must be integration-ready at launch)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# Zid. Either leave these blank and enter the pair in the panel
# (Integrations → CRM), or set them here; the panel wins where both exist.
#
# The store id and access token come from the Zid dashboard, Settings →
# «التكاملات مع واجهات البرمجة (API)». Note what that screen says about them:
# only an application Zid has authorised may use the pair. A store token on its
# own answers 401 Unauthenticated on every endpoint — the request also needs the
# OAuth token of a registered Zid app in `Authorization`, and pressing
# «إنشاء» reissues the token and invalidates the previous one.
ZID_API_BASE=https://api.zid.sa
ZID_STORE_ID=
# «رمز الوصول» from the dashboard — the store's manager token.
ZID_ACCESS_TOKEN=
# The OAuth token Zid issues when the store installs an application registered
# on the Zid partner portal. Both are required; with only the first, Zid
# answers 401 Unauthenticated on every endpoint.
ZID_OAUTH_TOKEN=

# ---- Anti-spam (§6.1) ------------------------------------------------------
# Cloudflare Turnstile. Leave blank to disable in local dev.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Privacy ---------------------------------------------------------------
# Salt used to hash visitor IPs. Raw IPs are never stored. Rotate with care:
# rotating invalidates dedup matching against historic leads.
IP_HASH_SALT=

# ---- Media library ---------------------------------------------------------
# Where uploads and their generated sizes live. `public` is correct for a
# single server; point MEDIA_DISK at s3 only if you also give the media a CDN.
MEDIA_DISK=public
MEDIA_CONVERSIONS_DISK=

# Conversions (medium, large, webp) are generated on the queue. The `thumb`
# used by the media grid is always generated synchronously, so the panel works
# either way — but WITHOUT a running queue worker the larger sizes and the
# WebP never appear, and pages keep serving the originals. See §15.1.
QUEUE_CONVERSIONS_BY_DEFAULT=true

# GD ships with PHP; imagick is faster on large files if the host has it.
IMAGE_DRIVER=gd

# ---- Page cache ------------------------------------------------------------
# Seconds a public page stays cached. 0 disables it, which is what local wants.
PAGE_CACHE_TTL=0

# ---- Error reporting -------------------------------------------------------
# Empty means OFF, and off is the shipped state. Nothing is captured and
# nothing leaves the server until a DSN is set here.
#
# Turning it on is a decision about where this project's data goes: unhandled
# exceptions would be transmitted to Sentry's servers. `send_default_pii` is
# false in config/sentry.php, so request bodies, headers and user identities
# are NOT sent — but a message or a query in a trace can still carry a name.
# For a site whose buyers are public bodies, that is Amad Craft's call.
#
# What it buys: on the live site a 500 currently reaches the visitor,
# APP_DEBUG=false rightly hides the trace, and the only record is a line in
# storage/logs/laravel.log that nobody is watching.
SENTRY_LARAVEL_DSN=

# Fraction of requests traced for performance. Leave empty for none; errors
# are reported regardless. Never 1.0 in production — it samples every request.
SENTRY_TRACES_SAMPLE_RATE=

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# NOTE: tracking IDs (GA4, GTM, Meta Pixel, Clarity …) are deliberately NOT
# here. Per §14.1 they are managed from `settings` in the admin panel so the
# client can change them without a deploy.
###############################################################################
